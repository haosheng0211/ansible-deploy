[www]
user = {{ projects_user }}
group = {{ projects_group }}

listen = /run/php/php{{ php_version }}-fpm.sock
listen.owner = {{ projects_user }}
listen.group = www-data
listen.mode = 0660

pm = dynamic
; Baseline for a 4 vCPU / 8 GB host shared with MariaDB, Redis and Node.js.
pm.max_children = 24
pm.start_servers = 4
pm.min_spare_servers = 4
pm.max_spare_servers = 8
pm.max_requests = 500

; Logging
slowlog = /var/log/php{{ php_version }}-fpm-slow.log
request_slowlog_timeout = 5s

; Security
php_admin_value[expose_php] = Off
php_admin_value[disable_functions] = passthru,shell_exec,system
php_admin_value[upload_max_filesize] = {{ php_upload_max_filesize }}
php_admin_value[post_max_size] = {{ php_post_max_size }}
php_admin_value[memory_limit] = 256M
php_admin_value[max_execution_time] = 60
