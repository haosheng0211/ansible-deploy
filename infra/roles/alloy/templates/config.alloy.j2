loki.write "default" {
  endpoint {
    url = "{{ loki_push_url }}"
  }
}

loki.source.file "nginx_access" {
  targets = [{
    __path__ = "/var/log/nginx/{access.log,*-access.log}"
    job      = "nginx"
    type     = "access"
    host     = "{{ ansible_hostname }}"
  }]
  forward_to = [loki.write.default.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "nginx_error" {
  targets = [{
    __path__ = "/var/log/nginx/{error.log,*-error.log}"
    job      = "nginx"
    type     = "error"
    host     = "{{ ansible_hostname }}"
  }]
  forward_to = [loki.write.default.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "laravel" {
  targets = [{
    __path__ = "/var/www/*/storage/logs/*.log"
    job      = "laravel"
    host     = "{{ ansible_hostname }}"
  }]
  forward_to = [loki.write.default.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "mariadb_slow" {
  targets = [{
    __path__ = "/var/log/mysql/slow.log"
    job      = "mariadb"
    type     = "slow"
    host     = "{{ ansible_hostname }}"
  }]
  forward_to = [loki.write.default.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "php_fpm_slow" {
  targets = [{
    __path__ = "/var/log/php{{ php_version }}-fpm-slow.log"
    job      = "php-fpm"
    type     = "slow"
    host     = "{{ ansible_hostname }}"
  }]
  forward_to = [loki.write.default.receiver]
  file_match {
    enabled = true
  }
}

loki.source.file "system" {
  targets = [
    { __path__ = "/var/log/fail2ban.log", job = "fail2ban", host = "{{ ansible_hostname }}" },
    { __path__ = "/var/log/auth.log", job = "auth", host = "{{ ansible_hostname }}" },
    { __path__ = "/var/log/syslog", job = "syslog", host = "{{ ansible_hostname }}" },
  ]
  forward_to = [loki.write.default.receiver]
  file_match {
    enabled = true
  }
}
