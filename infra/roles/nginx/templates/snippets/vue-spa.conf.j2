# Managed by Ansible (nginx role). Vue SPA built with Vite; set "root" to the dist/ output.
# Compression comes from the http-level gzip settings in nginx.conf.
index index.html;

# Vite puts hashed bundles under /assets/; a new build gets new file names
location ^~ /assets/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    access_log off;
    include snippets/security-headers.conf;
}

location = /index.html {
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    include snippets/security-headers.conf;
}

# History-mode routes fall back to index.html
location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    include snippets/security-headers.conf;
}

location ~ /\.(?!well-known) {
    deny all;
}
