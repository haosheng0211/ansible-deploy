# Managed by Ansible (nginx role). Static Nuxt build with ssr: false; set "root" to the generated output.
# Compression comes from the http-level gzip settings in nginx.conf.
index index.html;

# App manifest: must not be cached, or clients miss new builds
location ^~ /_nuxt/builds/ {
    try_files $uri =404;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    include snippets/security-headers.conf;
}

# Hashed assets never change once built
location ^~ /_nuxt/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    access_log off;
    include snippets/security-headers.conf;
}

location = /index.html {
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    include snippets/security-headers.conf;
}

location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache, max-age=0, must-revalidate" always;
    include snippets/security-headers.conf;
}

location ~ /\.(?!well-known) {
    deny all;
}
