server:
  http_listen_port: 9080
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yml

clients:
  - url: "{{ loki_push_url }}"

scrape_configs:
  # Nginx access log
  - job_name: nginx-access
    static_configs:
      - targets:
          - localhost
        labels:
          job: nginx
          type: access
          host: "{{ ansible_hostname }}"
          __path__: /var/log/nginx/*-access.log

  # Nginx error log
  - job_name: nginx-error
    static_configs:
      - targets:
          - localhost
        labels:
          job: nginx
          type: error
          host: "{{ ansible_hostname }}"
          __path__: /var/log/nginx/*-error.log

  # Laravel log (all projects under /var/www)
  - job_name: laravel
    static_configs:
      - targets:
          - localhost
        labels:
          job: laravel
          host: "{{ ansible_hostname }}"
          __path__: /var/www/*/storage/logs/*.log

  # MariaDB slow query log
  - job_name: mariadb-slow
    static_configs:
      - targets:
          - localhost
        labels:
          job: mariadb
          type: slow
          host: "{{ ansible_hostname }}"
          __path__: /var/log/mysql/slow.log

  # PHP-FPM slow log
  - job_name: php-fpm-slow
    static_configs:
      - targets:
          - localhost
        labels:
          job: php-fpm
          type: slow
          host: "{{ ansible_hostname }}"
          __path__: /var/log/php{{ php_version }}-fpm-slow.log

  # fail2ban log
  - job_name: fail2ban
    static_configs:
      - targets:
          - localhost
        labels:
          job: fail2ban
          host: "{{ ansible_hostname }}"
          __path__: /var/log/fail2ban.log

  # Auth log (SSH login)
  - job_name: auth
    static_configs:
      - targets:
          - localhost
        labels:
          job: auth
          host: "{{ ansible_hostname }}"
          __path__: /var/log/auth.log

  # Syslog
  - job_name: syslog
    static_configs:
      - targets:
          - localhost
        labels:
          job: syslog
          host: "{{ ansible_hostname }}"
          __path__: /var/log/syslog
